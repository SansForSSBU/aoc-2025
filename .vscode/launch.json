{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(Windows) Launch",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/src/solutions/puzzle2/puzzle2.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src/solutions/puzzle2",
            "environment": [],
            "console": "internalConsole"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Module",
            "type": "debugpy",
            "request": "launch",
            "program": "src/main.py",
            "args": ["${input:programArgs}"]
        }
    ],
    "inputs": [
        {
            "id": "programArgs",
            "type": "promptString",
            "description": "Which puzzle to debug?"
        }
    ]
}